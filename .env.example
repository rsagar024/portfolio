# GitHub Integration
NEXT_PUBLIC_GITHUB_USERNAME=rsagar024
# Optional: GitHub token (no scopes needed) to raise the API rate limit. Data is cached for 1 hour anyway.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# Contact form — sent from the browser via FormSubmit (free, no API key). Optional: defaults to
# sagarsahusts@gmail.com. After activating, you can use the random alias FormSubmit emails you instead.
# NEXT_PUBLIC_CONTACT_EMAIL=sagarsahusts@gmail.com

# GitHub Pages path prefix (set automatically by .github/workflows/deploy.yml). Leave empty locally.
# NEXT_PUBLIC_BASE_PATH=/portfolio

# Site URL — your real domain (used for canonical URL, OG links, sitemap.xml, robots.txt, JSON-LD).
# On Vercel it falls back to the project's production domain if unset.
NEXT_PUBLIC_SITE_URL=https://sagar.dev
